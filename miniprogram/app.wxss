/* 全局样式 */

page {
  /* 品牌色与墨色（对应浏览器版 :root 变量） */
  --brand: oklch(0.66 0.115 205);
  --brand-deep: oklch(0.58 0.12 210);
  --brand-tint: oklch(0.66 0.115 205 / 0.12);
  --ink-1: oklch(0.27 0.012 260);
  --ink-2: oklch(0.42 0.012 260);
  --ink-3: oklch(0.56 0.01 260);
  --ink-4: oklch(0.68 0.008 260);

  background: #eaf2f4;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: var(--ink-1);
  font-size: 28rpx;
  line-height: 1.5;
}

/* ── test 验证页样式（保留） ── */
.container { padding: 32rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.title { font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; color: #0085CA; }
.muted { color: #999; font-size: 24rpx; }
.row { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.row:last-child { border-bottom: none; }

/* ── 共享原语 ── */
.screen-pad { padding: calc(env(safe-area-inset-top) + 22px) 16px calc(env(safe-area-inset-bottom) + 120px); }

.glass {
  background: rgba(255,255,255,0.5);
  backdrop-filter: blur(22px) saturate(180%);
  -webkit-backdrop-filter: blur(22px) saturate(180%);
  border-radius: 22px;
  border: 0.5px solid rgba(255,255,255,0.7);
  box-shadow: inset 0 1px 1px rgba(255,255,255,0.7), 0 6px 22px rgba(28,38,76,0.10);
}

/* ── 动画彩色背景（玻璃折射底） ── */
.bg { position: absolute; inset: 0; z-index: 0; overflow: hidden; background: linear-gradient(165deg, #eaf5f6 0%, #eef0f8 48%, #f7eef4 100%); }
.orb { position: absolute; border-radius: 50%; filter: blur(58px); opacity: 0.5; }
.o1 { width: 260px; height: 260px; background: #E3002B; top: -40px; left: -60px; opacity: 0.32; }
.o2 { width: 280px; height: 280px; background: #97D700; top: 120px; right: -90px; }
.o3 { width: 240px; height: 240px; background: #0085CA; top: 380px; left: -70px; opacity: 0.42; }
.o4 { width: 260px; height: 260px; background: #5F259F; bottom: 30px; right: -70px; opacity: 0.34; }
.o5 { width: 220px; height: 220px; background: #FCD600; bottom: -40px; left: 40px; opacity: 0.4; }

/* ── 品牌头 ── */
.brand { display: flex; align-items: center; gap: 12px; padding: 4px 4px 20px; }
.brand-name {
  font-size: 40px; font-weight: 900; letter-spacing: 4px; line-height: 1.05;
  background: linear-gradient(115deg, var(--brand) 0%, var(--brand-deep) 55%, #5F259F 100%);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent; color: transparent;
  text-shadow: 0 4px 18px oklch(0.6 0.12 205 / 0.22);
}
.brand-tag { font-size: 12.5px; font-weight: 600; color: var(--ink-3); margin-top: 6px; letter-spacing: 3px; white-space: nowrap; }

/* ── CTA ── */
.cta {
  width: 100%; height: 56px; border-radius: 18px; border: none;
  background: linear-gradient(150deg, var(--brand), var(--brand-deep)); color: #fff;
  font-size: 18px; font-weight: 800; letter-spacing: 1px;
  display: flex; align-items: center; justify-content: center; gap: 8px;
  box-shadow: 0 10px 24px oklch(0.6 0.12 205 / 0.42);
}
.cta::after { border: none; } /* 去掉小程序 button 默认边框 */
.cta:active { transform: scale(0.97); }
