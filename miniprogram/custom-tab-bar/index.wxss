.dock-wrap {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(env(safe-area-inset-bottom) + 4rpx);
  z-index: 999;
}
.dock {
  height: 128rpx;
  display: flex;
  padding: 0 12rpx;
  border-radius: 52rpx;
  background: rgba(255, 255, 255, 0.68);
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  box-shadow: inset 0 2rpx 2rpx rgba(255,255,255,0.78), 0 12rpx 36rpx rgba(28,38,76,0.16);
  backdrop-filter: blur(28rpx) saturate(180%);
  -webkit-backdrop-filter: blur(28rpx) saturate(180%);
}
.dock-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #8d949f;
}
.dock-icon { width: 46rpx; height: 46rpx; opacity: 0.74; }
.dock-label { font-size: 22rpx; line-height: 1; font-weight: 600; }
.dock-tab.on { color: #0085CA; }
.dock-tab.on .dock-icon { opacity: 1; }
