.sheet-body { display: flex; flex-direction: column; gap: 12px; max-height: 60vh; }
.sheet-reason { font-size: 14px; color: var(--ink-2); line-height: 1.6; padding: 2px 4px; }

.toilet-card {
  background: rgba(255,255,255,0.66); border: 0.5px solid rgba(255,255,255,0.7);
  border-radius: 20px; padding: 15px; box-shadow: 0 2px 10px rgba(28,38,76,0.06);
}
.toilet-card.primary {
  background: rgba(255,255,255,0.9); border: 1.5px solid var(--brand);
  box-shadow: 0 8px 24px oklch(0.66 0.11 205 / 0.22);
}
.tc-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
.tc-top-left { flex: 1; min-width: 0; }
.tc-name { font-size: 17px; font-weight: 800; color: var(--ink-1); display: flex; align-items: center; gap: 8px; }
.tc-loc { font-size: 12.5px; color: var(--ink-3); margin-top: 4px; }
.tc-walk { display: flex; align-items: center; gap: 5px; flex-shrink: 0; color: var(--ink-2); font-size: 13px; white-space: nowrap; }
.tc-walk-ic { width: 16px; height: 16px; }
.tc-walk-b { font-size: 18px; color: var(--brand); font-weight: 800; }
.tc-stats { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 13px; }
.tc-chip {
  display: inline-flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 600;
  color: var(--ink-2); background: rgba(120,120,128,0.1); padding: 5px 9px; border-radius: 9px;
}
.tc-chip-ic { width: 13px; height: 13px; }
.alt-label { font-size: 13px; font-weight: 700; color: var(--ink-3); margin: 8px 4px 0; }
.empty-hint { font-size: 14px; color: var(--ink-3); text-align: center; padding: 24px; }
