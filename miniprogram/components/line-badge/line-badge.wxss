.lb { display: inline-flex; gap: 4px; }
.lb-wrap { max-width: 240rpx; flex-wrap: wrap; justify-content: flex-end; gap: 4px; }
.lb-dot {
  border-radius: 50%;
  color: #fff;
  font-weight: 700;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 1px 2px rgba(0,0,0,0.18);
}
