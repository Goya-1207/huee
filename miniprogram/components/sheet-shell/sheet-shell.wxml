<view class="sheet-wrap" bindtap="onClose">
  <view class="sheet" catchtap="noop">
    <view class="sheet-grab"></view>
    <view class="sheet-head">
      <view class="sheet-head-main">
        <view wx:if="{{kicker}}" class="sheet-kicker">
          <image wx:if="{{kickerIconSrc}}" class="sheet-kicker-ic" src="{{kickerIconSrc}}" />
          <text>{{kicker}}</text>
        </view>
        <view class="sheet-title">{{title}}</view>
      </view>
      <view class="sheet-close" catchtap="onClose">
        <image src="{{closeIconSrc}}" />
      </view>
    </view>
    <slot></slot>
  </view>
</view>
