.sheet-body { display: flex; flex-direction: column; gap: 12px; max-height: 60vh; }
.td-summary {
  display: flex; flex-direction: column; gap: 10px; padding: 2px 4px 16px;
  border-bottom: 0.5px solid rgba(60,60,67,0.1); margin-bottom: 4px;
}
.td-station { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.td-name { font-size: 20px; font-weight: 800; color: var(--ink-1); }
.hub-tag { font-size: 10px; font-weight: 700; color: var(--brand); background: var(--brand-tint); padding: 2px 6px; border-radius: 6px; }
.td-walk { display: flex; align-items: center; gap: 6px; color: var(--ink-2); font-size: 14px; }
.td-walk-ic { width: 18px; height: 18px; }
.td-walk-b { color: var(--brand); font-size: 19px; font-weight: 800; }
.td-walk-sub { color: var(--ink-4); font-size: 12.5px; }

.td-section { margin-bottom: 14px; padding: 0 4px; }
.td-label { font-size: 12px; font-weight: 700; letter-spacing: 0.5px; color: var(--ink-3); margin-bottom: 9px; }
.td-row {
  display: flex; align-items: flex-start; gap: 12px; padding: 11px 12px;
  background: rgba(255,255,255,0.55); border-radius: 14px; margin-bottom: 6px;
  border: 0.5px solid rgba(255,255,255,0.7);
}
.td-ic { width: 22px; height: 22px; flex-shrink: 0; margin-top: 1px; }
.td-row-title { font-size: 15px; font-weight: 700; color: var(--ink-1); }
.td-row-sub { font-size: 12.5px; color: var(--ink-3); margin-top: 3px; line-height: 1.5; }

.td-facility-grid { display: flex; gap: 8px; }
.td-facility {
  flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 14px 4px;
  background: rgba(255,255,255,0.65); border-radius: 14px; border: 0.5px solid rgba(255,255,255,0.7);
}
.td-facility.off { opacity: 0.42; }
.td-facility-ic { width: 20px; height: 20px; }
.td-facility-l { font-size: 13.5px; font-weight: 700; color: var(--ink-1); }
.td-facility-s { font-size: 11px; color: var(--ink-3); }

.td-note { font-size: 13px; color: var(--ink-2); line-height: 1.6; padding: 12px 14px; background: rgba(255,236,184,0.4); border-radius: 12px; border-left: 3px solid #ED8B00; }
.td-source { font-size: 11px; color: var(--ink-4); padding: 8px 4px; }
