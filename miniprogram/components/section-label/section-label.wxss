.sl { display: flex; align-items: center; gap: 7px; padding: 0 4px 9px; }
.sl-ic { width: 16px; height: 16px; flex-shrink: 0; }
.sl-label { font-size: 13px; font-weight: 700; letter-spacing: 0.3px; color: var(--ink-3); }
.sl-hint { font-size: 12px; color: var(--ink-4); margin-left: auto; font-weight: 500; }
