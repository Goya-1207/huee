.map { width: 100%; height: 100vh; }
.map-notice {
  position: absolute; top: 16px; left: 12px; right: 12px;
  padding: 8px 12px; border-radius: 10px;
  background: rgba(255, 247, 237, 0.95); color: #9a4f00;
  font-size: 12px; text-align: center;
}

.map-card {
  position: absolute; left: 12px; right: 12px;
  bottom: calc(env(safe-area-inset-bottom) + 24px);
  background: rgba(255,255,255,0.95);
  border-radius: 18px; padding: 14px 16px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.18);
  max-height: 46%;
}
.mc-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.mc-title { display: flex; align-items: center; gap: 6px; flex: 1; min-width: 0; }
.mc-name { font-size: 18px; font-weight: 700; color: #1f2937; }
.mc-hub { font-size: 10px; font-weight: 700; color: #0085CA; background: rgba(0,133,202,0.12); padding: 2px 6px; border-radius: 6px; }
.mc-close { width: 28px; height: 28px; line-height: 28px; text-align: center; font-size: 18px; color: #6b7280; }
.mc-badges { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 6px; }
.mc-dot { color: #fff; font-size: 11px; font-weight: 700; padding: 2px 7px; border-radius: 999px; }
.mc-empty { font-size: 13px; color: #6b7280; padding: 6px 0; }
.mc-row { display: flex; align-items: center; gap: 8px; padding: 7px 0; border-top: 1px solid rgba(0,0,0,0.06); }
.mc-pos { font-size: 11px; font-weight: 700; flex-shrink: 0; width: 44px; }
.mc-area { font-size: 11px; font-weight: 700; flex-shrink: 0; width: 44px; }
.mc-desc { font-size: 11px; color: #4a5568; flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
