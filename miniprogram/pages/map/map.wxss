.map { width: 100%; height: 100vh; }
.map-notice {
  position: absolute; top: 16px; left: 12px; right: 12px;
  padding: 8px 12px; border-radius: 10px;
  background: rgba(255, 247, 237, 0.95); color: #9a4f00;
  font-size: 12px; text-align: center;
}

.map-card {
  position: absolute; left: 12px; right: 12px;
  bottom: calc(env(safe-area-inset-bottom) + 148rpx);
  background: rgba(255,255,255,0.95);
  border-radius: 18px; padding: 14px 16px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.18);
  max-height: 48%;
  overflow-y: auto;
}
.mc-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.mc-title { display: flex; align-items: center; gap: 6px; flex: 1; min-width: 0; }
.mc-name { font-size: 18px; font-weight: 700; color: #1f2937; }
.mc-hub { font-size: 10px; font-weight: 700; color: #0085CA; background: rgba(0,133,202,0.12); padding: 2px 6px; border-radius: 6px; }
.mc-close { width: 28px; height: 28px; line-height: 28px; text-align: center; font-size: 18px; color: #6b7280; }
.mc-favorite { margin-left: 6px; padding: 5px 7px; border-radius: 8px; color: #7b8794; background: rgba(120,130,145,0.10); font-size: 10px; font-weight: 700; white-space: nowrap; }
.mc-favorite.on { color: #B88600; background: rgba(217,163,0,0.12); }
.mc-badges { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 6px; }
.mc-dot { color: #fff; font-size: 11px; font-weight: 700; padding: 2px 7px; border-radius: 999px; }
.mc-empty { font-size: 13px; color: #6b7280; padding: 6px 0; }
.mc-toilet-grid { display: flex; flex-direction: column; gap: 8px; }
.mc-toilet-card { padding: 10px; border-radius: 12px; background: rgba(248,250,252,0.94); border: 1px solid rgba(0,133,202,0.10); }
.mc-toilet-card.closed { opacity: 0.64; }
.mc-toilet-head { display: flex; align-items: center; gap: 6px; }
.mc-toilet-title { font-size: 13px; font-weight: 800; color: #253044; }
.mc-line { min-width: 18px; height: 18px; padding: 0 4px; border-radius: 9px; color: #fff; font-size: 10px; font-weight: 800; line-height: 18px; text-align: center; }
.mc-closed { margin-left: auto; color: #C24A38; background: rgba(194,74,56,0.10); border-radius: 7px; padding: 2px 5px; font-size: 10px; font-weight: 700; }
.mc-meta { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 7px; }
.mc-meta-item, .mc-facility, .mc-near { padding: 3px 6px; border-radius: 7px; background: rgba(255,255,255,0.94); font-size: 10px; font-weight: 700; }
.mc-walk { color: #64748B; }
.mc-facilities { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 6px; }
.mc-facility.on { color: #167C54; background: rgba(46,165,106,0.10); }
.mc-facility.off { color: #9AA0A8; background: rgba(120,120,128,0.08); }
.mc-near { display: inline-block; margin-top: 6px; color: #697586; }
.mc-desc { margin-top: 7px; color: #4a5568; font-size: 11px; line-height: 1.45; white-space: normal; }
