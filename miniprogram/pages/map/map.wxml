<!--pages/map/map.wxml-->
<view class="map-page">
  <map
    class="map"
    longitude="{{center.longitude}}"
    latitude="{{center.latitude}}"
    scale="{{scale}}"
    polyline="{{mapPolylines}}"
    enable-poi="{{true}}"
    bindpoitap="onPoiTap"
    bindregionchange="onRegionChange"
    show-location="{{false}}"
    enable-overlooking="{{false}}"
  ></map>

  <view wx:if="{{unmappedStationCount}}" class="map-notice">
    {{unmappedStationCount}} 个站点暂缺地图坐标，可在首页手动选择
  </view>

  <view class="map-card" wx:if="{{selectedSt}}">
    <view class="mc-head">
      <view class="mc-title">
        <view class="mc-name">{{selectedSt.name}}</view>
        <view wx:if="{{selectedSt.hub}}" class="mc-hub">换乘</view>
      </view>
      <view class="mc-favorite {{selectedSt.favorite ? 'on' : ''}}" catchtap="onToggleFavorite">{{selectedSt.favorite ? '★ 已收藏' : '☆ 收藏'}}</view>
      <view class="mc-close" bindtap="closeCard">✕</view>
    </view>
    <scroll-view class="mc-scroll" scroll-y enhanced show-scrollbar="{{false}}" bounces="{{false}}">
      <view class="mc-badges">
        <view wx:for="{{selectedSt.lines}}" wx:key="n" class="mc-dot" style="background:{{item.color}}">{{item.label}}</view>
      </view>
      <view wx:if="{{selectedSt.toilets.length === 0}}" class="mc-empty">暂无厕所数据</view>
      <view class="mc-toilet-grid">
        <view wx:for="{{selectedSt.toilets}}" wx:key="id" class="mc-toilet-card {{item.closed ? 'closed' : ''}}">
          <view class="mc-toilet-head">
            <view class="mc-toilet-title">{{item.title}}</view>
            <view class="mc-line" style="background:{{item.lineColor}}">{{item.lineLabel}}</view>
            <view wx:if="{{item.closed}}" class="mc-closed">暂停使用</view>
          </view>
          <view class="mc-meta">
            <view class="mc-meta-item" style="color:{{item.posColor}}">{{item.posLabel}}</view>
            <view class="mc-meta-item" style="color:{{item.areaColor}}">{{item.area}}</view>
            <view class="mc-meta-item mc-walk">{{item.walkLabel}}</view>
          </view>
          <view class="mc-facilities">
            <view wx:for="{{item.facilities}}" wx:for-item="facility" wx:key="label" class="mc-facility {{facility.on ? 'on' : 'off'}}">{{facility.label}}{{facility.on ? '可用' : '无'}}</view>
          </view>
          <view wx:if="{{item.near}}" class="mc-near">近 {{item.near}}</view>
          <view class="mc-desc">{{item.desc}}</view>
        </view>
      </view>
      <view class="mc-scroll-safe"></view>
    </scroll-view>
  </view>
</view>
