<view class="profile-page" wx:if="{{profile}}">
  <view class="profile-hero"><image class="hero-icon" src="{{appIcon}}" /><view><view class="hero-title">我的偏好</view><view class="hero-sub">让每次推荐更懂你</view></view></view>
  <view class="profile-card">
    <view class="card-title">如厕偏好</view>
    <view class="field-title">优先寻找</view><view class="choice-row"><view wx:for="{{genders}}" wx:key="key" class="choice {{profile.gender===item.key?'on':''}}" data-key="{{item.key}}" bindtap="onGenderTap">{{item.label}}</view></view>
    <view class="field-title">本次需求</view><view class="choice-row"><view wx:for="{{needs}}" wx:key="key" class="choice {{profile.need===item.key?'on':''}}" data-key="{{item.key}}" bindtap="onNeedTap">{{item.label}}</view></view>
    <view class="field-title">默认可忍耐时间</view><view class="choice-row"><view wx:for="{{holds}}" wx:key="value" class="choice {{profile.hold===item.value?'on':''}}" data-value="{{item.value}}" bindtap="onHoldTap">{{item.label}}</view></view>
  </view>
  <view class="profile-card"><view class="card-title">收藏站点</view><view wx:if="{{favoriteStations.length}}" class="station-list"><view wx:for="{{favoriteStations}}" wx:key="id" class="station-item"><view><text class="station-name">{{item.name}}</text><text class="station-lines">{{item.lineText}}</text></view><view class="remove" data-id="{{item.id}}" bindtap="onRemoveStation">已收藏</view></view></view><view wx:else class="empty">在首页选择站点时，点击收藏即可加入这里。</view></view>
  <view class="profile-card"><view class="card-title">常用线路</view><view class="line-grid"><view wx:for="{{lineOptions}}" wx:key="key" class="line-choice {{item.on?'on':''}}" style="{{item.on ? ('background:'+item.color+';color:#fff') : ('color:'+item.color)}}" data-key="{{item.key}}" bindtap="onToggleLine">{{item.label}}</view></view></view>
  <view class="profile-card feedback" bindtap="onFeedback"><view><view class="card-title">信息反馈</view><view class="feedback-sub">上报厕所位置、状态或功能建议</view></view><view class="feedback-arrow">›</view></view>
</view>
