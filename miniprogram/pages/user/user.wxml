<!--pages/user/user.wxml-->
<view class="container">
  <!-- 头部 -->
  <view class="hero">
    <image class="hero-icon" src="{{appIcon}}" mode="aspectFit"/>
    <view class="hero-name">沪屙屙</view>
    <view class="hero-sub">上海地铁找厕所 · v{{version}}</view>
  </view>

  <!-- 数据概况 -->
  <view class="card">
    <view class="card-title">数据概况</view>
    <view class="stat-row">
      <view class="stat-item">
        <text class="stat-num">{{stationCount}}</text>
        <text class="stat-label">地铁站</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{toiletCount}}</text>
        <text class="stat-label">厕所</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{lineCount}}</text>
        <text class="stat-label">线路</text>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="card">
    <view class="card-title">关于</view>
    <view class="info-row" bindtap="onCopyVersion">
      <text>版本</text>
      <text class="info-val">v{{version}}（点击复制）</text>
    </view>
    <view class="info-row">
      <text>数据来源</text>
      <text class="info-val">上海地铁官方公开信息</text>
    </view>
    <view class="info-row">
      <text>坐标系</text>
      <text class="info-val">GCJ-02（腾讯地图）</text>
    </view>
    <view class="info-row">
      <text>补充坐标</text>
      <text class="info-val">© OpenStreetMap contributors</text>
    </view>
    <view class="info-row">
      <text>运行环境</text>
      <text class="info-val">微信小程序 · 离线运行</text>
    </view>
  </view>

  <!-- 提示 -->
  <view class="card">
    <view class="card-title">使用提示</view>
    <view class="tip">· 定位到最近地铁站需授权位置权限</view>
    <view class="tip">· 推荐策略综合考虑憋忍时间、换乘、闸内外</view>
    <view class="tip">· 中途站只推荐闸内厕所，避免出站重进</view>
    <view class="tip">· 地铁图 Tab 可浏览全网厕所分布</view>
  </view>

  <view class="footer">让每一次都能从容解决 💧</view>
</view>
