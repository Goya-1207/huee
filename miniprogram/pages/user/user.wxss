.profile-page { min-height: 100vh; box-sizing: border-box; padding: calc(env(safe-area-inset-top) + 42rpx) 28rpx calc(env(safe-area-inset-bottom) + 176rpx); background: linear-gradient(165deg,#eaf5f6,#f6f1f7); }
.profile-hero { display:flex; align-items:center; gap:18rpx; margin:0 8rpx 30rpx; }.hero-icon{width:84rpx;height:84rpx}.hero-title{font-size:44rpx;font-weight:900;color:#1f2937}.hero-sub,.feedback-sub{margin-top:4rpx;color:#7a8797;font-size:24rpx}.profile-card{margin-bottom:20rpx;padding:28rpx;border-radius:26rpx;background:rgba(255,255,255,.8);box-shadow:0 10rpx 30rpx rgba(28,38,76,.07)}.card-title{font-size:30rpx;font-weight:800;color:#253044}.field-title{margin:24rpx 0 12rpx;color:#64748b;font-size:23rpx;font-weight:700}.choice-row,.line-grid{display:flex;flex-wrap:wrap;gap:12rpx}.choice{padding:14rpx 20rpx;border-radius:14rpx;background:#f2f5f7;color:#64748b;font-size:25rpx;font-weight:700}.choice.on{background:#0085ca;color:#fff;box-shadow:0 6rpx 14rpx rgba(0,133,202,.22)}.station-list{margin-top:12rpx}.station-item{display:flex;align-items:center;justify-content:space-between;padding:18rpx 0;border-bottom:1rpx solid rgba(60,70,80,.08)}.station-item:last-child{border-bottom:0}.station-name{display:block;color:#263247;font-size:29rpx;font-weight:800}.station-lines{display:block;margin-top:4rpx;color:#7c8796;font-size:22rpx}.remove{padding:8rpx 12rpx;border-radius:10rpx;background:rgba(0,133,202,.1);color:#0085ca;font-size:22rpx;font-weight:700}.empty{margin-top:16rpx;color:#8b95a4;font-size:24rpx}.line-choice{padding:10rpx 14rpx;border-radius:12rpx;background:#f5f7f9;font-size:23rpx;font-weight:800}.feedback{display:flex;align-items:center;justify-content:space-between}.feedback-arrow{color:#0085ca;font-size:48rpx;line-height:1}
