/* pages/user/user.wxss */
.container { padding: 32rpx; }

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
}
.hero-icon { width: 96rpx; height: 96rpx; margin-bottom: 16rpx; }
.hero-name { font-size: 40rpx; font-weight: 700; color: #0085CA; }
.hero-sub { font-size: 24rpx; color: #999; margin-top: 8rpx; }

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.stat-row { display: flex; justify-content: space-around; }
.stat-item { display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 48rpx; font-weight: 700; color: #0085CA; }
.stat-label { font-size: 24rpx; color: #999; margin-top: 8rpx; }

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}
.info-row:last-child { border-bottom: none; }
.info-val { color: #999; font-size: 26rpx; }

.tip {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  padding: 4rpx 0;
}

.footer {
  text-align: center;
  color: #ccc;
  font-size: 24rpx;
  padding: 32rpx 0;
}
